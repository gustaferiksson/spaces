# Copy to .env (git-ignored). Sourced by build.sh. Unset => ad-hoc build.
# An ad-hoc build gets a new code identity on every build, so Accessibility must be re-granted each time.
DEVELOPMENT_TEAM=XXXXXXXXXX
CODE_SIGN_IDENTITY="Developer ID Application"
# notarytool keychain profile for ./notarize.sh (see SHIPPING.md).
NOTARY_PROFILE=Spaces
